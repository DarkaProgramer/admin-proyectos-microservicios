{
  "uid": "gestor-k6",
  "title": "Gestor de Proyectos - Pruebas de carga k6",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "tags": [
    "gestor",
    "k6"
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Usuarios virtuales (VUs)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (testid) (k6_vus)",
          "legendFormat": "VUs {{testid}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Peticiones por segundo",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (testid) (rate(k6_http_reqs_total[30s]))",
          "legendFormat": "{{testid}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Latencia p95",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (testid) (k6_http_req_duration_p95)",
          "legendFormat": "p95 {{testid}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Latencia promedio y maxima",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (testid) (k6_http_req_duration_avg)",
          "legendFormat": "promedio {{testid}}"
        },
        {
          "refId": "B",
          "expr": "max by (testid) (k6_http_req_duration_max)",
          "legendFormat": "maximo {{testid}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Tasa de errores",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (testid) (k6_http_req_failed_rate)",
          "legendFormat": "errores {{testid}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Verificaciones correctas (checks)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min by (testid) (k6_checks_rate)",
          "legendFormat": "checks {{testid}}"
        }
      ]
    }
  ]
}